# ==========================================
# Telegram API sozlamalari (https://my.telegram.org)
# ==========================================
API_ID=12345678
API_HASH=your_api_hash_here

# Telethon StringSession (Server yoki bulutli xosting, masalan Railway/Render uchun)
# export_session.py orqali olinadi
TELETHON_SESSION=

# ==========================================
# Sun'iy Intellekt (Google Gemini AI) sozlamalari
# ==========================================
# AI orqali aqlli javob berish yoqilsinmi? (True / False)
USE_AI=True

# Google AI Studio dan olingan bepul API kalit (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Foydalaniladigan asosiy Gemini modeli (zaxira modellar: gemini-3.5-flash, gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash

# Xabarning pastiga qo'yiladigan AI belgisi (o'chirish uchun 'none' yoki bo'sh qoldiring)
AI_DISCLAIMER="— AI yordamchi 🤖"

# Sun'iy intellektga tizimli ko'rsatma (System instruction/prompt)
AI_SYSTEM_INSTRUCTION="Siz foydalanuvchining shaxsiy sun'iy intellekt yordamchisisiz. Telegram orqali kelgan har qanday xabarga foydalanuvchi nomidan samimiy, do'stona, xushmuomala va tabiiy javob qaytaring. Suhbatdosh bilan odobli muloqot qiling, savollarga aniq va lo'nda javob bering. Javoblarni o'zbek tilida, ortiqcha cho'zmasdan, jonli insondek tabiiy tilda yozing."

# ==========================================
# Avto-javob va Xulq-atvor Sozlamalari
# ==========================================
# Birinchi marta yozayotgan foydalanuvchiga yuboriladigan zaxira xabar
FIRST_TIME_MESSAGE="Assalomu alaykum! Hozirda offline holatdaman. Bo'sh vaqtim bo'lishi bilan xabarlaringizga albatta javob qaytaraman. Rahmat!"

# Standart zaxira xabar (agar AI o'chiq bo'lsa)
AUTO_REPLY_MESSAGE="Assalomu alaykum! Hozirda bandman. Xabaringizni ko'rishim bilan javob qaytaraman. Rahmat!"

# AI javob yozishdan oldin kutadigan qisqa tanaffus (soniyalarda, masalan: 2)
REPLY_DELAY_SECONDS=2

# Bitta foydalanuvchiga qayta javob yuborish oralig'i (daqiqalarda, 0 bo'lsa har bir xabarga javob beradi)
COOLDOWN_MINUTES=0

# Faqat kontaktda bo'lmagan yangi odamlarga javob yuborilsinmi? (True / False)
REPLY_ONLY_NON_CONTACTS=False

# Guruhlardagi reply va @username orqali murojaatlarga ham javob berilsinmi? (True / False)
REPLY_GROUP_MENTIONS=False
