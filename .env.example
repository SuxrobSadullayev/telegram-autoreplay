# ==========================================
# Telegram API sozlamalari (https://my.telegram.org)
# ==========================================
API_ID=12345678
API_HASH=your_api_hash_here

# ==========================================
# Sun'iy Intellekt (Google Gemini AI) sozlamalari
# ==========================================
# AI orqali aqlli javob berish yoqilsinmi? (True / False)
USE_AI=True

# Google AI Studio dan olingan bepul API kalit (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Foydalaniladigan Gemini modeli
GEMINI_MODEL=gemini-2.5-flash

# Sun'iy intellektga ko'rsatma (System instruction/prompt)
AI_SYSTEM_INSTRUCTION="Siz foydalanuvchining shaxsiy sun'iy intellekt yordamchisisiz. Telegram shaxsiy xabarlariga foydalanuvchi nomidan xushmuomala, samimiy va lo'nda javob qaytaring. Foydalanuvchi hozirda bandligini va xabarni ko'rishi bilan o'zi ham yozishini eslatib o'ting. Agar suhbatdosh aniq bir savol bergan bo'lsa, qisqa va foydali ma'lumot berishga harakat qiling. Javobni o'zbek tilida, tabiiy va do'stona ohangda yozing."

# ==========================================
# Qo'shimcha va Zaxira Sozlamalari
# ==========================================
# Agar AI o'chiq bo'lsa yoki xatolik yuz bersa yuboriladigan zaxira matn:
AUTO_REPLY_MESSAGE="Assalomu alaykum! Hozirda bandman. Xabaringizni ko'rishim bilan javob qaytaraman. Rahmat!"

# Bitta foydalanuvchiga qayta javob yuborish oralig'i (daqiqalarda)
COOLDOWN_MINUTES=60

# Faqat kontaktda bo'lmagan yangi odamlarga javob yuborilsinmi? (True / False)
REPLY_ONLY_NON_CONTACTS=False
